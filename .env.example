# IMCC Server Configuration
PORT=3000
NODE_ENV=development

# JWT Secret Key (replace with a long random string in production)
JWT_SECRET=replace_with_a_long_random_secret_key

# Persistent directory for SQLite database and uploaded images
# Local: ./data | Production (Render / Railway / Fly.io): /data
DATA_DIR=./data

# Initial Executive Admin account (created automatically on first startup)
ADMIN_EMAIL=admin@imanimining.com
ADMIN_PASSWORD=ChangeThisPassword2026!
ADMIN_NAME=IMCC Management
